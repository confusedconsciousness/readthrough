# Copy to .env (git ignores it). `npm start` and the Docker image read these.

# Postgres, for a team. Leave it unset to use SQLite in one file instead (READTHROUGH_SQLITE, default ./readthrough.db).
# If it's set but unreachable, Readthrough stops with an error rather than quietly using SQLite.
# DATABASE_URL=postgres://readthrough:readthrough@127.0.0.1:5433/readthrough
# READTHROUGH_SQLITE=./readthrough.db

# ---- Hosted mode: set GITHUB_CLIENT_ID to switch it on. Leave this block empty to run in local mode. ----

# From your GitHub App's settings page (see README, "Deploy").
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's slug, the last part of https://github.com/apps/<slug>. Used for the "install the app" link.
GITHUB_APP_SLUG=

# Where people open Readthrough. The GitHub App's callback URL must be this plus /auth/callback.
# On app.example.com, the bare example.com shows only the landing page and sends sign-in here.
# PUBLIC_URL=https://app.readthrough.example.com

# Encrypts GitHub tokens in the database. 32+ random characters: openssl rand -base64 48
# Changing it later signs everyone out.
READTHROUGH_SECRET=

# Optional: only members of these GitHub organizations (comma-separated) may sign in.
READTHROUGH_ALLOWED_ORGS=
# Optional: these GitHub logins (comma-separated) may sign in. With the waitlist on, only people on one of the two lists can.
READTHROUGH_ALLOWED_USERS=
# Put a waitlist on the landing page instead of sign-in (anyone can join; read it with: select * from waitlist).
READTHROUGH_WAITLIST=

# ---- Optional ----
# PORT=4400
# HOST=0.0.0.0
# READTHROUGH_EFFORT=high        # how hard Claude thinks per read: low, medium, high, xhigh, max
