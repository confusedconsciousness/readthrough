# Copy to .env (git ignores it). `npm start` and the Docker image read these.

# Postgres, for a team. Leave it unset to use SQLite in one file instead (ODYSSEY_SQLITE, default ./odyssey.db).
# If it's set but unreachable, Odyssey stops with an error rather than quietly using SQLite.
# DATABASE_URL=postgres://odyssey:odyssey@127.0.0.1:5433/odyssey
# ODYSSEY_SQLITE=./odyssey.db

# ---- Hosted mode: set GITHUB_CLIENT_ID to switch it on. Leave this block empty to run in local mode. ----

# From your GitHub App's settings page (see README, "Deploy").
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# The app's slug, the last part of https://github.com/apps/<slug>. Used for the "install the app" link.
GITHUB_APP_SLUG=

# Where people open Odyssey. The GitHub App's callback URL must be this plus /auth/callback.
# PUBLIC_URL=https://odyssey.example.com

# Encrypts GitHub tokens and AI keys in the database. 32+ random characters: openssl rand -base64 48
# Changing it later signs everyone out and forgets saved AI keys.
ODYSSEY_SECRET=

# Optional: only members of these GitHub organizations (comma-separated) may sign in.
ODYSSEY_ALLOWED_ORGS=

# ---- Optional ----
# PORT=4400
# HOST=0.0.0.0
# ODYSSEY_EFFORT=high        # how hard Claude thinks per read: low, medium, high, xhigh, max
